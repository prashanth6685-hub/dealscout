# DealScout — copy to .env, never commit real secrets
PORT=4000
NODE_ENV=development
# Demo data: true ONLY in development. When true, the MockProvider serves
# clearly-labeled sample offers (UI shows a DEMO DATA banner everywhere).
ENABLE_MOCK_PROVIDER=true

# --- Retailer / affiliate credentials (server-only, all optional) ---
# eBay Browse API + eBay Partner Network
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=
# Amazon Product Advertising API + Associates (requires approval)
AMAZON_PA_ACCESS_KEY=
AMAZON_PA_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=
AMAZON_PARTNER_ID=
# Walmart Affiliate / Content API (requires approval)
WALMART_API_KEY=
WALMART_AFFILIATE_ID=
# AliExpress Affiliate API (requires approval)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# Best Buy API
BESTBUY_API_KEY=
# Database (shared catalog / price history only — never user searches)
DATABASE_URL=
REDIS_URL=
